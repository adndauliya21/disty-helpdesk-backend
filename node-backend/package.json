{
  "name": "disty-helpdesk-node",
  "version": "1.0.0",
  "description": "Backend Node.js (Modul 3) untuk Disty HelpDesk. Kontrak API dan database sama dengan versi Laravel.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "busboy": "1.6.0",
    "mysql2": "3.11.3"
  }
}
