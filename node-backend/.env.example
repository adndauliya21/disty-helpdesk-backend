# Salin menjadi .env lalu sesuaikan. Nama variabel sengaja sama dengan .env Laravel,
# jadi nilai DB_* dan JWT_SECRET boleh disalin langsung. Dengan JWT_SECRET yang sama,
# token dari backend Laravel juga diterima backend Node.js, dan sebaliknya.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=disty_helpdesk
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=rahasia-pengembangan-jangan-dipakai-di-produksi
JWT_EXPIRES_SECONDS=28800
DOMAIN_STAF=perusahaan.id
# Asal frontend yang boleh memanggil API. Pisahkan dengan koma. * hanya untuk pengembangan.
CORS_ORIGIN=*
# Folder frontend dan unggahan foto. Bawaannya folder public milik proyek Laravel.
PUBLIC_DIR=../laravel/public
# Biaya bcrypt. 12 sama dengan bawaan Laravel.
BCRYPT_ROUNDS=12
