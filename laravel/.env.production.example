# [MODUL 7] Contoh .env untuk SERVER PRODUCTION. Salin ke server sebagai .env (JANGAN di-commit, sudah ada di .gitignore):
#   cp .env.production.example .env  &&  chmod 640 .env
# Lalu isi semua nilai bertanda GANTI. Cek hasilnya dengan:  php artisan disty:periksa-produksi

APP_NAME="Disty HelpDesk"
APP_ENV=production
# Isi otomatis dengan:  php artisan key:generate --force
APP_KEY=
# WAJIB false di produksi: true membocorkan detail kesalahan.
APP_DEBUG=false
# GANTI: alamat API (https setelah sertifikat dipasang)
APP_URL=https://api.contoh.co.id

# Log harian, disimpan 14 hari di storage/logs, hanya peringatan ke atas.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Database production ---
# Pakai akun khusus aplikasi dengan hak hanya pada database ini (bukan root). deploy/setup-vps-ubuntu.sh membuatkannya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=disty_helpdesk
DB_USERNAME=disty_app
# GANTI
DB_PASSWORD=
# Database terkelola di cloud (DigitalOcean, AWS RDS, dst.): isi DB_HOST dengan alamat dari penyedia, lalu bila wajib SSL:
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# API ini tanpa sesi dan tanpa cache database, jadi tidak butuh tabel tambahan.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# --- Keamanan ---
# GANTI: teks acak minimal 32 karakter.  Buat dengan:  openssl rand -base64 48
# Kalau diganti, semua token yang beredar tidak berlaku lagi (pengguna perlu login ulang).
JWT_SECRET=
JWT_EXPIRES_SECONDS=28800
# GANTI: alamat frontend persis (skema + host [+ port], tanpa garis miring di akhir).
# Lebih dari satu dipisah koma:  https://helpdesk.contoh.co.id,https://www.contoh.co.id
CORS_ORIGIN=https://helpdesk.contoh.co.id

# --- Hanya untuk seeder pertama (php artisan db:seed --class=ProductionSeeder --force) ---
# Kosongkan ADMIN_PASSWORD kalau mau diketik lewat prompt tersembunyi. HAPUS barisnya dari .env setelah seeder berhasil.
# ADMIN_EMAIL=admin@perusahaan.id   # [MODUL 8] email inilah yang dipakai untuk login di frontend
# ADMIN_NAME="Admin Disty"
# ADMIN_PASSWORD=
