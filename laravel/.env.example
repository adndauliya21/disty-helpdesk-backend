# Salin menjadi .env lalu sesuaikan:  cp .env.example .env   (lalu: php artisan key:generate)
APP_NAME="Disty HelpDesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=disty_helpdesk
DB_USERNAME=root
DB_PASSWORD=

# API ini tanpa sesi dan tanpa cache database, jadi tidak butuh tabel tambahan.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

JWT_SECRET=ganti-dengan-teks-acak-panjang
# JWT_EXPIRES_SECONDS=28800
# CORS_ORIGIN=http://localhost:5500
